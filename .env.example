# Copier ce fichier vers .env.local pour le développement local.

# URL publique du site, sans slash final (obligatoire en production).
# Sert de base aux URL absolues des métadonnées (image Open Graph, Twitter Card).
# Si absente, repli sur VERCEL_PROJECT_PRODUCTION_URL / VERCEL_URL (injectées
# par Vercel), puis sur http://localhost:3000.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
